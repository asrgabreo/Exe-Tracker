{
  "name": "backend",
  "version": "1.0.0",
  "description": "MERN exercise tracker API and client",
  "main": "server.js",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "test": "npm --prefix client test",
    "build": "npm --prefix client run build",
    "install-client": "npm --prefix client install",
    "heroku-postbuild": "npm run install-client && npm run build",
    "start": "node server.js",
    "client": "npm --prefix client run dev",
    "dev": "concurrently -n 'server,client' -c 'red,green' \"nodemon server.js\" \"npm run client\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "mongoose": "^9.6.1",
    "morgan": "^1.10.1"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.14"
  }
}
